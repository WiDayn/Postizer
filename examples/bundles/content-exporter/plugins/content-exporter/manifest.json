{
  "id": "content-exporter",
  "type": "plugin",
  "name": "Content Exporter",
  "version": "1.0.0",
  "description": "Export all posts, pages, and media into a downloadable ZIP archive.",
  "runtime": {
    "kind": "grpc",
    "command": "${go}",
    "args": [
      "run",
      "./cmd/postizer-content-exporter"
    ]
  },
  "services": [
    {
      "name": "postizer.plugin.v1.PluginService",
      "methods": [
        "Handshake",
        "InvokeAction",
        "Shutdown"
      ]
    }
  ],
  "requires": {
    "postizer": "v1.3.0",
    "host_services": [
      {
        "name": "postizer.plugin.v1.HostService",
        "methods": [
          "CreateContentExport"
        ]
      }
    ]
  },
  "ui_entries": [
    {
      "id": "export",
      "outlet": "admin.plugin",
      "path": "ui/export.json"
    }
  ],
  "permissions": [
    "content.read",
    "media.read"
  ]
}
