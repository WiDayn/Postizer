{{define "feed.xml"}}<rss version="2.0">
  <channel>
    <title>{{siteMainTitle .}}</title>
    <link>/</link>
    <description>{{siteFeedDescription .}}</description>
    {{range .Posts}}
    <item>
      <title>{{.Title}}</title>
      <link>/posts/{{.Slug}}</link>
      <guid>/posts/{{.Slug}}</guid>
      <pubDate>{{date .Date}}</pubDate>
      <description>{{.Summary}}</description>
    </item>
    {{end}}
  </channel>
</rss>
{{end}}
