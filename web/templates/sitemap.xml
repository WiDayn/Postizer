{{define "sitemap.xml"}}<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>/</loc></url>
  <url><loc>/archive</loc></url>
  <url><loc>/tags</loc></url>
  {{range .Posts}}<url><loc>{{postURL .}}</loc></url>{{end}}
  {{range .Pages}}<url><loc>{{pageURL .}}</loc></url>{{end}}
  {{range .Tags}}<url><loc>{{tagURL .}}</loc></url>{{end}}
</urlset>
{{end}}
